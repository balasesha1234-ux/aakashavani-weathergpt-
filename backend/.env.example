# ==============================================================================
# AAKASHAVANI BACKEND CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# Database Connection (Neon PostgreSQL in production or SQLite locally)
# Local: sqlite:///aakashavani.db
# Neon / Render: postgresql://<user>:<password>@<neon-host>/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
 
# Distributed Redis Cache (Render Key-Value or external Redis)
# Render internal URL format: redis://red-xxxxxxxx:6379
# Leave blank to automatically use in-memory RAM fallback
REDIS_URL=redis://red-xxxxxxxx:6379

# Application Host & Port
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Application Domain Routing (Vercel Frontend & Render Backend)
# Local Dev:
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Production (Set in Render dashboard):
# FRONTEND_URL=https://aakashavani.vercel.app
# BACKEND_URL=https://aakashavani-backend.onrender.com

# JWT Authentication Secret
JWT_SECRET=your-secure-random-jwt-secret-key-at-least-32-chars

# ------------------------------------------------------------------------------
# Google OAuth 2.0 / OpenID Connect Configuration
# ------------------------------------------------------------------------------
# Register in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0
# Authorized redirect URIs:
# Local:      http://localhost:8000/api/v1/auth/google/callback
# Production: https://your-backend.onrender.com/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ------------------------------------------------------------------------------
# Sign in with Apple Configuration
# ------------------------------------------------------------------------------
# Register in Apple Developer -> Certificates, Identifiers & Profiles -> Services IDs
# Authorized Return URLs:
# Local:      http://localhost:8000/api/v1/auth/apple/callback
# Production: https://your-backend.onrender.com/api/v1/auth/apple/callback
APPLE_CLIENT_ID=com.aakashavani.web
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_KEY_ID=YYYYYYYYYY
# Raw .p8 private key string with newlines or single-line escaped (\n)
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APPLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/apple/callback

# ------------------------------------------------------------------------------
# AI Models & Multi-Agent Inference
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=AIzaSy_your_gemini_api_key
GEMINI_MODEL=gemini-flash-latest
OPENAI_API_KEY=sk-your-openai-api-key

# Local Edge LLM (Suraksha360 / Ollama)
PREFER_LOCAL_LLM=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=suraksha360:latest
LOCAL_MODEL=suraksha360
