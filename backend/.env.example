# ==========================================
# AakashaVani Backend Configuration (.env)
# ==========================================

# 1. Database Connection URL
DATABASE_URL=sqlite:///./aakashavani.db
# Production Neon PostgreSQL:
# DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# 2. Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
CORS_ORIGINS=*

# 3. Cloud LLM API Keys (Optional but recommended)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

OPENAI_API_KEY=

# 4. Sovereign Local On-Device LLM (NVIDIA RTX 5050 - 8GB Dedicated VRAM)
PREFER_LOCAL_LLM=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=suraksha360
LOCAL_MODEL=suraksha360

# 5. Phase 4 Multi-Model Intelligence Ecosystem
MODEL_LOCAL_QWEN_PROVIDER=local_ollama
MODEL_LOCAL_QWEN_NAME=suraksha360
MODEL_SURAKSHA360_PROVIDER=local_ollama
MODEL_SURAKSHA360_NAME=suraksha360
MODEL_WEATHER_PROVIDER=groq
MODEL_WEATHER_NAME=openai/gpt-oss-120b
MODEL_SAFETY_PROVIDER=groq
MODEL_SAFETY_NAME=openai/gpt-oss-120b
MODEL_GENERAL_PROVIDER=local_ollama
MODEL_GENERAL_NAME=suraksha360
MODEL_REASONING_PROVIDER=groq
MODEL_REASONING_NAME=openai/gpt-oss-120b
ENABLE_SELECTIVE_VALIDATION=true
