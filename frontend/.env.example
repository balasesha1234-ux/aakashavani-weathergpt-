# ==========================================
# AakashaVani Frontend Configuration (.env)
# ==========================================

# Set to your deployed FastAPI backend URL (or leave blank for localhost:8000)
# Example for local development:
VITE_API_URL=http://localhost:8000

# Example for production deployment (Render / Railway / Fly.io / AWS):
# VITE_API_URL=https://your-backend-app.onrender.com

# Optional: Google One-Tap / Pop-up Client ID from Google Cloud Console
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
